<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
    <file source-language="en" datatype="plaintext" original="messages" date="2026-10-19T00:00:00Z" product-name="mklog">
        <header/>
        <body>
            <trans-unit id="scheduler_watchdog_name" resname="scheduler_watchdog_name">
                <source>MK Log WatchDog</source>
            </trans-unit>
            <trans-unit id="scheduler_watchdog_description" resname="scheduler_watchdog_description">
                <source>Sends new developer log entries to a transport (mail or Gelf/GrayLog).</source>
            </trans-unit>
            <trans-unit id="scheduler_watchdog.transport" resname="scheduler_watchdog.transport">
                <source>Transport</source>
            </trans-unit>
            <trans-unit id="scheduler_watchdog.credentials" resname="scheduler_watchdog.credentials">
                <source>Credentials</source>
            </trans-unit>
            <trans-unit id="scheduler_watchdog.credentials.description" resname="scheduler_watchdog.credentials.description">
                <source>Mail: recipient address. Gelf UDP: host:port, e.g. 127.0.0.1:12201. Gelf HTTP: URL, e.g. https://user:pass@127.0.0.1:2345/gelf</source>
            </trans-unit>
            <trans-unit id="scheduler_watchdog.severity" resname="scheduler_watchdog.severity">
                <source>Min severity</source>
            </trans-unit>
            <trans-unit id="scheduler_watchdog.message_limit" resname="scheduler_watchdog.message_limit">
                <source>Message limit per run</source>
            </trans-unit>
            <trans-unit id="scheduler_watchdog.message_limit.description" resname="scheduler_watchdog.message_limit.description">
                <source>0 means no limit.</source>
            </trans-unit>
            <trans-unit id="scheduler_watchdog.extension_whitelist" resname="scheduler_watchdog.extension_whitelist">
                <source>Extension whitelist</source>
            </trans-unit>
            <trans-unit id="scheduler_watchdog.extension_blacklist" resname="scheduler_watchdog.extension_blacklist">
                <source>Extension blacklist</source>
            </trans-unit>
            <trans-unit id="scheduler_watchdog.extension_list.description" resname="scheduler_watchdog.extension_list.description">
                <source>Comma separated list of extension keys.</source>
            </trans-unit>
            <trans-unit id="scheduler_watchdog.mail_subject" resname="scheduler_watchdog.mail_subject">
                <source>Custom mail subject</source>
            </trans-unit>
            <trans-unit id="scheduler_watchdog.mail_subject.description" resname="scheduler_watchdog.mail_subject.description">
                <source>%s is replaced by the site name. Default: DevLog WatchDog on site %s</source>
            </trans-unit>
            <trans-unit id="scheduler_watchdog.error.credentials_required" resname="scheduler_watchdog.error.credentials_required">
                <source>The credentials for the transport are required!</source>
            </trans-unit>
            <trans-unit id="scheduler_watchdog.error.credentials_invalid" resname="scheduler_watchdog.error.credentials_invalid">
                <source>The credentials do not match the selected transport (Mail: email address, Gelf UDP: host:port, Gelf HTTP: URL).</source>
            </trans-unit>
            <trans-unit id="scheduler_cleanup_log_table_name" resname="scheduler_cleanup_log_table_name">
                <source>Cleanup mklog entries</source>
            </trans-unit>
            <trans-unit id="scheduler_cleanup_log_table_description" resname="scheduler_cleanup_log_table_description">
                <source>Cleanup mklog log table and deletes all entries over configured value (max_logs).</source>
            </trans-unit>
        </body>
    </file>
</xliff>
